    {
      "parameters": {
        "toolDescription": "Consulta el clima EXTERIOR actual de una ciudad (servicio /clima de la Practica 0). Devuelve temperatura_actual_c, temperatura_max_c, prob_lluvia_pct, viento_kmh y mensaje.",
        "url": "http://localhost:5678/webhook/clima",
        "sendQuery": true,
