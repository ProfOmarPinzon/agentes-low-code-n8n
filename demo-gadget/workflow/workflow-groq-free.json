    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"pantalla\": {\n      \"type\": \"string\",\n      \"maxLength\": 60\n    },\n    \"nivel\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"ok\",\n        \"atencion\",\n        \"alerta\"\n      ]\n    },\n    \"detalle\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"pantalla\",\n    \"nivel\",\n    \"detalle\"\n  ]\n}"
      },
