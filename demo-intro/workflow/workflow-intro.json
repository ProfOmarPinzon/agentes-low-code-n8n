              "id": "12b1500a-b9a7-4252-8abe-5c70abf6a0f4",
              "name": "prob_lluvia_pct",
              "value": "={{ $json.daily.precipitation_probability_max[0] }}",
              "type": "number"
            },
            {
              "id": "203eafa6-54c0-4875-8bb5-e85bd85784b3",
              "name": "viento_kmh",
              "value": "={{ $json.current.wind_speed_10m }}",
              "type": "number"
            }
