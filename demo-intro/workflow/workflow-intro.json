              "value": "={{ $('Geocodificar ciudad').first().json.results[0].name }}",
              "type": "string"
            },
            {
              "id": "51427f48-5dc4-48a5-8d2c-94dfbe09c9ca",
              "name": "pais",
              "value": "={{ $('Geocodificar ciudad').first().json.results[0].country }}",
              "type": "string"
            },
            {
              "id": "b8da5a74-3b30-4d8c-bf0e-bed9d4162868",
              "name": "temperatura_actual_c",
              "value": "={{ $json.current.temperature_2m }}",
              "type": "number"
            },
            {
              "id": "92e02910-0e61-4835-a994-681c7ddbe139",
              "name": "temperatura_max_c",
              "value": "={{ $json.daily.temperature_2m_max[0] }}",
