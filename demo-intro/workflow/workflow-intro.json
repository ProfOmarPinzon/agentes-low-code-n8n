              "name": "ciudad",
              "value": "={{ $json.query?.ciudad ?? 'Bogota' }}",
              "type": "string"
            },
            {
              "id": "4f3d9099-b9fa-430e-889c-eeebea608ae4",
              "name": "umbral_lluvia",
              "value": "50",
              "type": "number"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        100
      ],
      "id": "ee8bb818-1e87-40a0-acc2-ca71f775c667",
      "name": "Parámetros"
    },
    {
      "parameters": {
        "url": "=https://geocoding-api.open-meteo.com/v1/search?name={{ encodeURIComponent($json.ciudad) }}&count=1&language=es&format=json",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "id": "675f88c9-9f85-443e-9d51-cd0fc14f04e0",
      "name": "Geocodificar ciudad"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "aebf26d1-a3fe-4b51-bd7c-23c9f01ed799",
              "leftValue": "={{ ($json.results || []).length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        100
      ],
      "id": "46d69db9-5f12-4e03-b046-5045ea4430a7",
      "name": "¿Ciudad encontrada?"
    },
    {
      "parameters": {
        "url": "=https://api.open-meteo.com/v1/forecast?latitude={{ $json.results[0].latitude }}&longitude={{ $json.results[0].longitude }}&current=temperature_2m,wind_speed_10m&daily=precipitation_probability_max,temperature_2m_max,temperature_2m_min&forecast_days=1&timezone=auto",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "id": "69e48704-1133-4731-8eaf-ebeaa726ca69",
      "name": "Consultar clima"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"Ciudad no encontrada\", \"ciudad\": $('Parámetros').first().json.ciudad } }}",
        "options": {
          "responseCode": 404
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        220
      ],
      "id": "311528c7-47c8-4556-90f1-8f5cccb3354e",
